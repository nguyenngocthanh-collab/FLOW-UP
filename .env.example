# ========================================================
# FLOW-UP Configuration (.env.example)
# Copy this file to .env or .env.local for development
# ========================================================

# --- Backend Server Configuration ---
PORT=3001
NODE_ENV=development
DATABASE_PATH=./data/flow-up.db
CORS_ORIGIN=http://localhost:5173

# --- Authentication Configuration ---
# Set to 'true' to allow local dev tokens (dev-token:<userId>:<email>) without live Supabase
AUTH_DEV_MODE=true

# Optional Supabase credentials (for live Supabase Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Frontend Client Configuration ---
VITE_APP_NAME=FLOW-UP
# Empty uses same-origin /api; Vite proxies it to the local backend in development.
# Set an absolute API base URL only when the production API is hosted separately.
VITE_API_BASE_URL=
