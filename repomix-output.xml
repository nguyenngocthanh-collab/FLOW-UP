    .og, .og * {
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }
    .og {
      color: ${G.text};
      -webkit-font-smoothing: antialiased;
      height: 100vh;
      overflow: hidden;
    }
    @media (max-width: 860px) {
      .og {
        height: auto;
        min-height: 100vh;
        overflow: visible;
      }
    }
    .og-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      height: 34px;
      padding: 0 12px;
      border-radius: 10px;
      border: 1px solid ${G.line};
      background: ${G.card};
      color: ${G.ink};
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .og-btn:hover {
      background: #f5f7fc;
      border-color: #cfd5ea;
    }
    .og-btn[aria-checked="true"] {
      background: ${G.indigoSoft};
      border-color: ${G.indigo};
      color: ${G.indigo};
    }
    .og-stage-tab {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      height: 30px;
      padding: 0 12px;
      border-radius: 999px;
      border: 1px solid ${G.line};
      background: #fff;
      color: ${G.muted};
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .og-stage-tab:hover {
      border-color: #c5cde8;
      color: ${G.ink};
    }
    .og-stage-tab.is-active {
      background: ${G.indigo};
      border-color: ${G.indigo};
      color: #ffffff;
    }
    .og-input {
      width: 100%;
      height: 36px;
      padding: 0 11px;
      border: 1px solid ${G.line};
      border-radius: 9px;
      background: #ffffff;
      color: ${G.ink};
      font-size: 13.5px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    textarea.og-input {
      height: auto;
      min-height: 52px;
      padding: 7px 11px;
      resize: vertical;
      line-height: 1.4;
    }
    .og-input:focus {
      outline: none;
      border-color: ${G.indigo};
      box-shadow: 0 0 0 3px rgba(79, 82, 217, 0.12);
    }
    .og-workspace {
      display: flex;
      flex-direction: column;
      gap: 14px;
      height: 100%;
      min-height: 0;
    }
    .og-tree-section {
      background: ${G.card};
      border: 1px solid ${G.line};
      border-radius: 14px;
      padding: 12px 18px 14px;
      flex: 0 0 auto;
      display: flex;
      flex-direction: column;
    }
    .og-tree-scroll {
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 6px 4px;
      scrollbar-width: thin;
      scrollbar-color: #cbd2e8 transparent;
    }
    .og-tree-scroll::-webkit-scrollbar {
      height: 6px;
    }
    .og-tree-scroll::-webkit-scrollbar-thumb {
      background: #cbd2e8;
      border-radius: 999px;
    }
    .og-bottom-grid {
      display: grid;
