.goal-workspace {
.gw-focus {
.gw-focus__main { min-width: 0; }
.gw-kicker,.gw-overline { color:var(--gw-muted);font:500 10px/1.4 'DM Mono',monospace;letter-spacing:.12em;text-transform:uppercase; }
.gw-focus h2 { margin:8px 0 6px;font:600 clamp(23px,2.4vw,31px)/1.16 'Space Grotesk',sans-serif;letter-spacing:-.035em; }
.gw-focus p { max-width:650px;margin:0;color:var(--gw-muted);font-size:13px;line-height:1.6; }
.gw-focus__meta { display:flex;flex-wrap:wrap;gap:7px;margin-top:14px; }
.gw-focus__next { align-self:center;padding:14px 16px;border:1px solid rgba(83,117,88,.18);border-radius:13px;background:rgba(255,255,255,.82); }
.gw-focus__next strong { display:block;margin:6px 0 10px;font-size:13px;line-height:1.45; }
.gw-focus__next button,.gw-primary-link,.gw-small-link { padding:0;border:0;background:none;color:var(--gw-green);font:600 12px 'DM Sans',sans-serif;cursor:pointer; }
.gw-chip { display:inline-flex;align-items:center;padding:5px 9px;border:1px solid var(--gw-line);border-radius:99px;background:#fff;color:#65736b;font-size:10px; }
.gw-toolbar { display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap; }
