.gw-view-switch button { padding:8px 11px;border:0;border-radius:8px;background:transparent;color:var(--gw-muted);font:600 11px 'DM Sans',sans-serif;cursor:pointer; }
.gw-view-switch button[aria-pressed="true"] { background:var(--gw-green-soft);color:var(--gw-green); }
.gw-toolbar__right { display:flex;align-items:end;gap:12px;flex-wrap:wrap; }
.gw-project-filter { display:grid;gap:4px;color:var(--gw-muted);font-size:10px; }
.gw-project-filter select { min-height:34px;padding:0 10px;border:1px solid var(--gw-line);border-radius:8px;background:#fff;color:var(--gw-ink); }
.gw-layout { display:grid;grid-template-columns:minmax(0,1fr) minmax(290px,350px);gap:15px;align-items:start; }
