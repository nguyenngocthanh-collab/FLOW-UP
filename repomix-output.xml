.calendar-workspace { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(280px, .8fr); align-items: start; gap: 16px; }
.calendar-panel, .calendar-unscheduled { min-width: 0; }
.calendar-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 18px; }
.calendar-toolbar__period { display: flex; align-items: center; gap: 14px; }
.calendar-toolbar__period h2, .calendar-unscheduled h2 { margin: 0; }
.calendar-toolbar__nav, .calendar-views { display: flex; align-items: center; gap: 6px; }
.calendar-toolbar__nav .button { min-height: 34px; padding: 5px 10px; }
.calendar-views { padding: 4px; border: 1px solid var(--line); border-radius: 10px; }
.calendar-views button { padding: 6px 10px; border: 0; border-radius: 7px; color: var(--muted); background: transparent; cursor: pointer; }
.calendar-views .calendar-view--active { color: var(--ink); background: var(--soft); font-weight: 650; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(106px, 1fr)); overflow: auto; border: 1px solid var(--line); border-radius: 12px; }
.calendar-grid__weekday { padding: 9px 11px; color: var(--muted); background: var(--soft); font-size: 11px; font-weight: 700; text-transform: uppercase; }
.calendar-date { display: grid; align-content: start; gap: 8px; min-width: 0; min-height: 112px; padding: 8px; border-top: 1px solid var(--line); border-right: 1px solid var(--line); background: var(--paper); }
.calendar-grid--week .calendar-date { min-height: 330px; }
.calendar-date--selected { box-shadow: inset 0 0 0 2px var(--green); }
.calendar-date--outside { background: #f9faf8; color: #9aa19b; }
.calendar-date__weekday { color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
.calendar-date__number { justify-self: start; width: 28px; height: 28px; border: 0; border-radius: 50%; color: inherit; background: transparent; font: inherit; cursor: pointer; }
.calendar-date--selected .calendar-date__number { color: white; background: var(--green); }
.calendar-date__events { display: grid; align-content: start; gap: 6px; min-width: 0; }
.calendar-date__events > small { color: var(--muted); font-size: 11px; }
.calendar-event { min-width: 0; padding: 10px; border: 1px solid #dce8df; border-left: 3px solid var(--green); border-radius: 9px; background: #f5faf6; }
.calendar-event--complete { border-color: var(--line); border-left-color: #9aa19b; background: var(--soft); }
.calendar-event--orphan { color: var(--muted); font-size: 12px; }
.calendar-event__main { display: grid; width: 100%; gap: 3px; padding: 0; border: 0; text-align: left; color: var(--ink); background: transparent; cursor: pointer; }
.calendar-event__main time, .calendar-event__main small, .calendar-event__state { color: var(--muted); font-size: 11px; }
.calendar-event__main strong { overflow: hidden; text-overflow: ellipsis; }
.calendar-date__events .calendar-event { padding: 5px 6px; border-left-width: 2px; }
.calendar-date__events .calendar-event__main { gap: 1px; }
.calendar-date__events .calendar-event__main time { font-size: 10px; }
.calendar-date__events .calendar-event__main strong { display: -webkit-box; overflow: hidden; font-size: 11px; line-height: 1.25; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.calendar-date__events .calendar-event__state, .calendar-date__events .calendar-event__main small { display: none; }
.calendar-event__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 9px; padding-top: 8px; border-top: 1px solid var(--line); }
.calendar-event__actions select { padding: 4px 6px; border: 1px solid var(--line); border-radius: 7px; color: var(--ink); background: white; font-size: 12px; }
.calendar-event__actions .text-link, .calendar-goal-link { padding: 0; border: 0; color: var(--green); background: transparent; font-size: 12px; cursor: pointer; }
.calendar-day-list { display: grid; gap: 12px; }
.calendar-day-list > header { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--line); }
.calendar-day-list > header span { color: var(--muted); }
.calendar-feedback { color: var(--muted); }
.calendar-unscheduled { display: grid; gap: 12px; }
.calendar-unscheduled .panel__heading { align-items: center; margin-bottom: 0; }
.calendar-unscheduled .panel__heading > span { display: grid; min-width: 28px; height: 28px; place-items: center; border-radius: 50%; background: var(--soft); color: var(--ink); font-size: 12px; }
.calendar-unscheduled .eyebrow { display: block; margin-bottom: 5px; }
.calendar-unscheduled ul { display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
.calendar-unscheduled li { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 11px 0; border-bottom: 1px solid var(--line); }
.calendar-unscheduled li > div { display: grid; min-width: 0; gap: 4px; }
.calendar-unscheduled li strong { overflow-wrap: anywhere; }
.calendar-unscheduled li .button { flex: 0 0 auto; min-height: 34px; padding: 5px 9px; }
.calendar-schedule-form { display: grid; gap: 11px; margin-top: 6px; padding: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--soft); }
.calendar-schedule-form > small { color: var(--muted); }
.calendar-schedule-form__times { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.calendar-schedule-form__actions { display: flex; justify-content: flex-end; gap: 8px; }
.calendar-schedule-form__actions .button { min-height: 36px; padding: 6px 12px; }
@media (max-width: 1000px) { .calendar-workspace { grid-template-columns: 1fr; } .calendar-unscheduled { order: -1; } .calendar-unscheduled ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 16px; } }
@media (max-width: 620px) { .calendar-toolbar { align-items: flex-start; flex-direction: column; } .calendar-toolbar__period { align-items: flex-start; flex-direction: column; } .calendar-grid { grid-template-columns: repeat(7, minmax(90px, 1fr)); } .calendar-grid--week .calendar-date { min-height: 240px; } .calendar-unscheduled ul { grid-template-columns: 1fr; } }
