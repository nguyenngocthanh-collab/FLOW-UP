  .np, .np * {
    box-sizing: border-box;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }

  .np {
    color: ${j.text};
    -webkit-font-smoothing: antialiased;
  }

  .np-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid ${j.line};
    background: ${j.card};
    color: ${j.ink};
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 0 1px 2px rgba(27, 32, 56, 0.04);
  }

  .np-btn:hover:not(:disabled) {
    background: #f5f7fc;
    border-color: #cfd5ea;
    transform: translateY(-0.5px);
  }

  .np-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .np-btn.primary {
    background: ${j.indigo};
    border-color: ${j.indigo};
    color: #ffffff;
    box-shadow: 0 3px 10px -3px rgba(79, 82, 217, 0.45);
  }

  .np-btn.primary:hover:not(:disabled) {
    background: #4245c7;
    border-color: #4245c7;
  }

  .np-btn.teal {
    background: ${j.tealSoft};
    border-color: #b4eae5;
    color: #0b8579;
  }

  .np-btn.teal:hover:not(:disabled) {
    background: #d1f1ee;
    border-color: ${j.teal};
  }

  .np-btn.danger {
    background: ${j.coralSoft};
    border-color: #f8c8c7;
    color: ${j.coral};
  }

  .np-btn.danger:hover:not(:disabled) {
    background: #fbd9d8;
    border-color: ${j.coral};
  }

  .np-edit-info-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 6px 10px;
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
    color: ${j.ink};
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .np-edit-info-btn:hover {
    background: #f4f6fc;
    border-color: ${j.line};
  }

  .np-edit-info-badge {
    width: 54px;
    height: 18px;
    border-radius: 4px;
    background: #8c92a4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
  }

  .np-edit-info-btn:hover .np-edit-info-badge {
    background: ${j.indigo};
  }

  .np-node {
    cursor: pointer;
    outline: none;
  }

  .np-node .np-pill {
    transition: fill 0.16s ease, stroke 0.16s ease;
  }

  .np-node:hover .np-pill {
    filter: brightness(0.97);
  }

  .np-node:focus-visible .np-pill {
    stroke: ${j.indigo};
    stroke-width: 2px;
  }

  /* B\u1ED1 c\u1EE5c 2 kh\u1ED1i c\xE2n b\u1EB1ng \u1EDF ch\xEDnh gi\u1EEFa b\xEAn d\u01B0\u1EDBi khung hi\u1EC3n th\u1ECB Tree */
  .np-bottom {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 32px;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
  }

  .np-bottom-card {
    background: ${j.panel};
    border: 1px solid ${j.line};
    border-radius: 12px;
    padding: 24px 26px;
    min-height: 380px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .np-tree-viewport {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    cursor: grab;
    user-select: none;
    border-radius: 10px;
    padding-bottom: 6px;
  }

  .np-tree-viewport.is-dragging {
    cursor: grabbing;
  }

  .np-tree-viewport::-webkit-scrollbar {
    height: 8px;
  }

  .np-tree-viewport::-webkit-scrollbar-track {
    background: #f4f6fc;
    border-radius: 99px;
  }

  .np-tree-viewport::-webkit-scrollbar-thumb {
    background: #c5cde6;
    border-radius: 99px;
  }

  .np-tree-viewport::-webkit-scrollbar-thumb:hover {
    background: #9faad0;
  }

  @media (max-width: 920px) {
    .np-bottom {
      grid-template-columns: 1fr;
      max-width: 560px;
      gap: 20px;
    }

    .np-bottom-card {
      min-height: auto;
    }
  }

  .np-tree-scroll {
    margin-top: 12px;
    max-height: 290px;
    overflow-y: auto;
    padding-right: 4px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .np-tree-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .np-tree-scroll::-webkit-scrollbar-thumb {
    background: #ccd2e8;
    border-radius: 99px;
  }

  .np-tree-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 9px;
    border: 1px solid ${j.line};
    background: #ffffff;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }

  .np-tree-row:hover {
    border-color: #c5cde8;
  }

  .np-tree-row.is-selected {
    border-color: ${j.indigo};
    box-shadow: 0 0 0 2px rgba(79, 82, 217, 0.12);
  }

  .np-mini-icon {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: ${j.muted};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
  }

  .np-mini-icon:hover {
    background: #f4f6fc;
    color: ${j.ink};
  }

  .np-role-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 24px;
    padding: 0 8px;
    border-radius: 999px;
    border: 1px solid ${j.line};
    background: #f7f8fc;
    color: ${j.muted};
    font-size: 11.5px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .np-role-pill:hover {
    border-color: #c6cde6;
    color: ${j.ink};
  }

  .np-role-pill.is-core {
    background: ${j.tealSoft};
    border-color: #a4e4de;
    color: #0b8579;
  }

  .np-row-input {
    flex: 1;
    min-width: 60px;
    border: none;
    background: transparent;
    color: ${j.ink};
    font-size: 13px;
    font-weight: 500;
    padding: 3px 4px;
    outline: none;
  }

  .np-row-input::placeholder {
    color: #9aa2c2;
    font-style: italic;
  }

  .np-add-circle-btn {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: 1px solid #cfd5ee;
    background: #f7f8fc;
    color: ${j.indigo};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    transition: all 0.14s ease;
  }

  .np-add-circle-btn:hover {
    background: ${j.indigo};
    border-color: ${j.indigo};
    color: #ffffff;
  }

  .np-del-btn {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: ${j.muted};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    transition: all 0.14s ease;
  }

  .np-del-btn:hover {
    background: ${j.coralSoft};
    color: ${j.coral};
  }

  .np-input {
    width: 100%;
    border: 1px solid ${j.line};
    background: #ffffff;
    color: ${j.ink};
    border-radius: 10px;
    padding: 9px 12px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  input.np-input {
    height: 40px;
  }

  textarea.np-input {
    min-height: 120px;
    resize: vertical;
    line-height: 1.5;
  }

  .np-input:focus {
    background: #ffffff;
    border-color: ${j.indigo};
    box-shadow: 0 0 0 3px rgba(79, 82, 217, 0.12);
  }
